# ==============================================================================
# FGR Career Development Center — Environment Configuration Template
# For the Next.js application, copy to frontend/.env.local
# ==============================================================================

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Resend Email Integration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=FGR Career Development Center <noreply@fgrcareer.org>
STAFF_NOTIFICATION_EMAIL=contact@fgrcareer.org

# Admin Security Key
ADMIN_API_SECRET_KEY=your-very-strong-admin-secret-token-here
